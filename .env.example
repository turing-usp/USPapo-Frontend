# Copy to .env (never commit it). EXPO_PUBLIC_* values are inlined into the bundle at build time
# (public by design: the Supabase anon key relies on RLS).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Backend base URL: native calls it directly; the web dev server forwards /api to it.
EXPO_PUBLIC_BACKEND_URL=https://uspapo-backend.onrender.com
# The website (the password recovery link always finishes there, even when asked from the app).
# Optional: defaults to https://uspapo.turingusp.com; on the web the page's own origin is used.
EXPO_PUBLIC_WEB_URL=https://uspapo.turingusp.com
