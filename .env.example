# USPapo Frontend — environment template.
# Copy to `.env` and fill in. EXPO_PUBLIC_* values are inlined into the JS
# bundle at build time (they are public by design: the Supabase anon key
# relies on RLS, and the API URL is meant to be visible).
# Never commit a real .env.

# Supabase project URL (https://<ref>.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (publishable) key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL (POST <base>/chat).
# PENDING: placeholder until the new backend cutover is approved and
# deployed — see CUTOVER_RUNBOOK.md (PENDING USER APPROVAL).
EXPO_PUBLIC_API_URL=https://uspapo.turingusp.com/api
