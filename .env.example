# Copy to .env (never commit it). EXPO_PUBLIC_* values are inlined into the bundle at build time
# (public by design: the Supabase anon key relies on RLS).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Native only (web always calls the same-origin /api): the backend base URL.
EXPO_PUBLIC_BACKEND_URL=https://uspapo-backend.onrender.com
