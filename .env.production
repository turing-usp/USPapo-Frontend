# Production client configuration.
#
# Expo loads dotenv files by mode, and release builds (`expo export`, EAS
# build, `run:android --variant release`) run with NODE_ENV=production, so
# THIS file wins over `.env` for them while `.env` stays your local dev setup
# (local Supabase, LAN backend). Without it a release build baked
# 127.0.0.1:54321 into the APK and every sign-in failed with "check your
# connection" — the phone was dialling a Supabase that only exists on your
# machine.
#
# Real environment variables still take precedence over this file, so the
# values Vercel injects at build time continue to win on the web.
#
# Everything here is public by design: it all ships inside the client bundle,
# and the database is protected by RLS, not by hiding these.

EXPO_PUBLIC_SUPABASE_URL=https://zgvbnmovongrigjoviyu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZYlNqNjeRpqRV6pkKzta7A_6QjfYcl2

# Native only. The web build ignores this and calls the same-origin `/api`
# proxy instead (see lib/api.ts): the deployment's CSP is `connect-src 'self'`,
# so an absolute origin would be blocked by the browser.
EXPO_PUBLIC_BACKEND_URL=https://uspapo-backend.onrender.com
