{
  "name": "uspapo",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/katex.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/web-head.mjs dist",
    "update:preview": "sh scripts/update.sh preview",
    "update:production": "sh scripts/update.sh production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "apk:preview": "export EXPO_UPDATES_CHANNEL=preview && expo prebuild -p android --clean && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@ronradtke/react-native-markdown-display": "^9.0.3",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "katex": "^0.18.7",
    "markdown-it-texmath": "^1.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  }
}
